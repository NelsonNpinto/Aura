POSTGRES_USER=aura
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=aura
FRONTEND_PORT=5273
BACKEND_PORT=8200
POSTGRES_PORT=5433
OLLAMA_PORT=11434
# For running the backend outside Docker (match POSTGRES_PASSWORD above):
DATABASE_URL=postgresql+psycopg://aura:change-this-local-password@localhost:5433/aura
OLLAMA_BASE_URL=http://localhost:11434
# Required by hosted Ollama, and by any remote Ollama you put behind auth.
# Leave blank for a loopback server.
OLLAMA_API_KEY=
# sentence-transformers runs locally; ollama embeds remotely with no model weights
# installed. The chunk column is Vector(384), so an ollama model must emit 384
# dimensions: all-minilm does, nomic-embed-text does not.
EMBEDDING_PROVIDER=sentence-transformers
# Optional workspace access key. Blank is for loopback-only local development.
API_KEY=
# Generate with scripts/configure-local.py; ingestion is disabled if blank.
WEBHOOK_SECRET=
# Optional telemetry. Enable using scripts/configure-local.py --observability
OTEL_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://langfuse-web:3000
