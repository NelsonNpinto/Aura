# AURA environment variables. Copy to .env.local (git-ignored) and fill in.
# Values below are LOCAL docker-compose defaults or blanks. Never commit real secrets.

# --- App ---
APP_ENV=local                      # local | test | preview | production
GIT_SHA=dev
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000

# --- Postgres (Neon in prod: pooled URL for the app, direct URL for migrations) ---
DATABASE_URL=postgresql://aura:aura-local-only@localhost:5434/aura
DATABASE_URL_UNPOOLED=postgresql://aura:aura-local-only@localhost:5434/aura

# --- Redis (Upstash REST; local uses the serverless-redis-http container) ---
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-upstash-token

# --- Neo4j (AuraDB Free in prod) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=aura-local-only

# --- Langfuse Cloud (blank = export disabled; ai.traces still recorded) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0

# --- LLM providers ---
GROQ_API_KEY=
GEMINI_API_KEY=
ENABLE_BEDROCK=false
AWS_REGION=us-east-1
AWS_ROLE_ARN=
OLLAMA_BASE_URL=http://localhost:11435   # local dev only
# Non-production only: inject provider faults, e.g. "groq/*=429" to demo fallbacks.
ROUTER_FAULT_INJECTION=

# --- Specialist model (Phase 4) ---
HF_TOKEN=
SPECIALIST_SPACE_ID=
ENABLE_SPECIALIST=false

# --- Files ---
BLOB_READ_WRITE_TOKEN=             # blank = local filesystem store under .local/blob

# --- Auth ---
BETTER_AUTH_SECRET=                # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AURA_JWKS_URL=http://localhost:3000/api/auth/jwks
AURA_JWT_ISSUER=http://localhost:3000
AURA_JWT_AUDIENCE=aura-api

# --- Bot protection (Cloudflare published test keys: always pass) ---
TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Internal secrets (openssl rand -hex 32) ---
ERP_SERVICE_TOKEN=
WEBHOOK_SECRET=
DEMO_RESET_SECRET=
APPROVAL_TOKEN_SECRET=

# --- Budgets ---
DAILY_RUN_BUDGET=200
GUEST_DAILY_RUNS=10
RATE_LIMIT_PER_MINUTE=60

# --- CI only (GitHub secrets, never in .env.local) ---
# VERCEL_TOKEN, KAGGLE_USERNAME, KAGGLE_KEY
