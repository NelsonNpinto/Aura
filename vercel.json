{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs"
    },
    "api": {
      "root": "apps/api/",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "buildCommand": "export UV_LINK_MODE=copy HF_HUB_DISABLE_XET=1 && mkdir -p data && cp -R ../../evals/datasets/demo data/ && uv run --no-dev python -m app.scripts.fetch_models && uv run --no-dev python -m app.scripts.prune_bundle",
      "functions": {
        "app/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{tests/**,alembic/**,.local/**,**/._*,.venv/**,**/__pycache__/**}"
        }
      }
    },
    "erp": {
      "root": "services/erp-mock/",
      "framework": "fastapi",
      "entrypoint": "erp_mock.app:app",
      "buildCommand": "export UV_LINK_MODE=copy && uv sync --no-dev",
      "functions": {
        "erp_mock/app.py": {
          "maxDuration": 60,
          "excludeFiles": "{**/._*,.venv/**,**/__pycache__/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/mcp(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/erp/(.*)",
      "destination": {
        "service": "erp"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
